# Copy this file to .env and fill in the secrets before running `docker compose up`.
#
# Generate TAP_JWT_SECRET_KEY with:      python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate TAP_CREDENTIAL_ENCRYPTION_KEY with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (or via Docker if you don't have Python locally:
#   docker run --rm python:3.12-slim python3 -c "import secrets; print(secrets.token_urlsafe(48))")

# --- Postgres ---
POSTGRES_USER=tap
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tap

# --- Backend ---
TAP_ENVIRONMENT=production
TAP_DATABASE_URL=postgresql+asyncpg://tap:change-me@postgres:5432/tap
TAP_REDIS_URL=redis://redis:6379/0
TAP_JWT_SECRET_KEY=
TAP_CREDENTIAL_ENCRYPTION_KEY=
TAP_CORS_ORIGINS=["http://localhost:8080"]

# --- Frontend ---
# Left as the default "/api": the frontend's nginx reverse-proxies /api to the backend service,
# so this only needs to change if you serve the API from a different origin.
VITE_API_BASE_URL=/api
